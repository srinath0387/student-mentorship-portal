# =========================================================
# RGMCET Portal - Cloud Database Environment Configuration
# =========================================================

# 1. Supabase / Neon / AWS RDS / GCP Cloud PostgreSQL URL
CLOUD_DATABASE_URL=jdbc:postgresql://ep-rgmcet-portal.aws.neon.tech:5432/portal_db?sslmode=require

# 2. Cloud Database Credentials
CLOUD_DATABASE_USER=rgmcet_cloud_admin
CLOUD_DATABASE_PASSWORD=YourSecureCloudPassword123!

# 3. Optional Cloud Redis (Upstash / Redis Labs)
CLOUD_REDIS_HOST=rgmcet-redis.upstash.io
CLOUD_REDIS_PORT=6379

# 4. Active Spring Profile
SPRING_PROFILES_ACTIVE=cloud
